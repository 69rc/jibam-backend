# Server
NODE_ENV=development
PORT=5001

# ─── Database — PostgreSQL ────────────────────────────────────────────────────
# Option A: individual variables (local development)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jibam_pharmacy
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_SSL=false

# Option B: full connection URL (Railway / Render / Neon / Supabase)
# DATABASE_URL=postgresql://user:password@host:5432/jibam_pharmacy?sslmode=require

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=another_long_refresh_secret_key_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Paystack
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
PAYSTACK_BASE_URL=https://api.paystack.co

# OPay Payment Gateway
OPAY_MERCHANT_ID=your_opay_merchant_id
OPAY_API_KEY=your_opay_api_key
OPAY_SECRET_KEY=your_opay_secret_key
OPAY_BASE_URL=https://api.opaycheckout.com
OPAY_CALLBACK_URL=http://localhost:3002/payment/opay/callback
OPAY_WEBHOOK_SECRET=your_opay_webhook_secret

# WhatsApp pharmacist number (no + prefix)
PHARMACIST_WHATSAPP=2348000000000

# Frontend URLs
CUSTOMER_APP_URL=http://localhost:3002
ADMIN_DASHBOARD_URL=http://localhost:3001

# Email (Gmail example — use App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password

# Admin default account (used by seeder)
ADMIN_EMAIL=admin@jibampharmacy.com
ADMIN_PASSWORD=Admin@123456
ADMIN_FULLNAME=Jibam Admin
