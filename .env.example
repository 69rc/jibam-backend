# Server
NODE_ENV=development
PORT=5001

# Database — PostgreSQL (Neon DB)
# Option A: individual variables (local dev)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jibam_pharmacy
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false

# Option B: full connection URL (Railway / Render / Neon / Supabase)
# DATABASE_URL=postgresql://user:password@host:5432/jibam_pharmacy?sslmode=require

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_secret_key_here_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# Supabase Storage (for image uploads only - separate from Neon DB)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Paystack
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
PAYSTACK_BASE_URL=https://api.paystack.co

# WhatsApp
PHARMACIST_WHATSAPP=2348166444533

# WhatsApp Provider: meta | callmebot | twilio
WHATSAPP_PROVIDER=callmebot

# CallMeBot (free — easiest to set up)
# 1. Save +34 644 59 87 23 in your phone as "CallMeBot"
# 2. Send "I allow callmebot to send me messages" via WhatsApp to that number
# 3. You'll receive your API key in seconds
CALLMEBOT_APIKEY=your_callmebot_apikey

# Meta WhatsApp Business Cloud API (recommended for production)
# WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
# WHATSAPP_ACCESS_TOKEN=your_permanent_access_token

# Twilio (paid)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Frontend URLs
CUSTOMER_APP_URL=http://localhost:3002
ADMIN_DASHBOARD_URL=http://localhost:3001

# Email (nodemailer — use Gmail App Password)
# Setup: Google Account → Security → 2-Step Verification → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password

# Pharmacist notification email (receives order alerts — defaults to SMTP_USER if not set)
PHARMACIST_EMAIL=pharmacist@jibampharmacy.com

# Admin Defaults
ADMIN_EMAIL=admin@jibampharmacy.com
ADMIN_PASSWORD=Admin@123456
ADMIN_FULLNAME=Jibam Admin
